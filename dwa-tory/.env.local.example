# Skopiuj do .env.local i uzupełnij wartościami ze swojego projektu
# Supabase (Settings → API). Zobacz README.md, sekcja "Uruchomienie".

VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-public-key

# Push (krok 8, dokończenie) — klucz PUBLICZNY z pary VAPID wygenerowanej
# przez `npx web-push generate-vapid-keys`. Klucz PRYWATNY z tej samej pary
# NIGDY tutaj — trafia wyłącznie jako sekret Edge Function (patrz README,
# sekcja "Push").
VITE_VAPID_PUBLIC_KEY=twoj-klucz-publiczny-vapid
